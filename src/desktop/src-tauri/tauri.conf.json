{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HASM",
  "version": "0.0.0",
  "identifier": "com.hasm.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/apps/web/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "HASM — حسم", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://localhost:7241"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
